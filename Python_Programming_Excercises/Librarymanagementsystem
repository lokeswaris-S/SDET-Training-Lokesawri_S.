# ---------------- Book Class ----------------
class Book:
    def __init__(self, title, author, isbn):
        self._title = title
        self._author = author
        self._isbn = isbn
        self._availability = True

    def get_title(self):
        return self._title

    def get_author(self):
        return self._author

    def get_isbn(self):
        return self._isbn

    def is_available(self):
        return self._availability

    def set_availability(self, status):
        self._availability = status


# ---------------- Member Class ----------------
class Member:
    def __init__(self, name, member_id):
        self._name = name
        self._member_id = member_id
        self._borrowed_books = []

    def get_name(self):
        return self._name

    def get_member_id(self):
        return self._member_id

    def borrow_book(self, book):
        if book in self._borrowed_books:
            print("You already borrowed this book")
            return

        if book.is_available():
            self._borrowed_books.append(book)
            book.set_availability(False)
            print(f"{self._name} borrowed '{book.get_title()}'")
        else:
            raise Exception("Book is not available")

    def return_book(self, book):
        if book in self._borrowed_books:
            self._borrowed_books.remove(book)
            book.set_availability(True)
            print(f"{self._name} returned '{book.get_title()}'")
        else:
            print("This book was not borrowed by you")


# ---------------- Library Class ----------------
class Library:
    def __init__(self):
        self.books = []
        self.members = []

    def add_book(self, book):
        self.books.append(book)

    def add_member(self, member):
        self.members.append(member)

    def search_book(self, keyword):
        for book in self.books:
            if keyword.lower() in book.get_title().lower() or keyword.lower() in book.get_author().lower():
                return book
        raise Exception("Book not found")

    def find_member(self, member_id):
        for member in self.members:
            if member.get_member_id() == member_id:
                return member
        raise Exception("Member not found")

    def lend_book(self, isbn, member_id):
        try:
            book = next(b for b in self.books if b.get_isbn() == isbn)
            member = self.find_member(member_id)

            if not book.is_available():
                raise Exception("Book unavailable")

            member.borrow_book(book)

        except Exception as e:
            print("Error:", e)

    def return_book(self, isbn, member_id):
        try:
            book = next(b for b in self.books if b.get_isbn() == isbn)
            member = self.find_member(member_id)

            member.return_book(book)

        except Exception as e:
            print("Error:", e)


# ---------------- Main Program ----------------
def main():
    library = Library()

    # Create sample books
    book1 = Book("Python Basics", "Guido", "101")
    book2 = Book("AI Made Easy", "Andrew", "102")
    book3 = Book("DSA Mastery", "Rahul", "103")

    # Add books to library
    library.add_book(book1)
    library.add_book(book2)
    library.add_book(book3)

    # Create members
    member1 = Member("Loki", "M01")
    member2 = Member("Alice", "M02")

    # Add members
    library.add_member(member1)
    library.add_member(member2)

    print("\n--- Lending Book ---")
    library.lend_book("101", "M01")

    print("\n--- Trying to lend same book again ---")
    library.lend_book("101", "M02")

    print("\n--- Returning Book ---")
    library.return_book("101", "M01")

    print("\n--- Searching Book ---")
    try:
        book = library.search_book("Python")
        print("Found book:", book.get_title())
        print("Available:", book.is_available())
    except Exception as e:
        print("Error:", e)


# Run program
if __name__ == "__main__":
    main()
