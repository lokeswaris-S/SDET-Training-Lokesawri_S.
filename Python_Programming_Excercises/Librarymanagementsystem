# --- Book class ---
class Book:
    def __init__(self, title, author, ISBN):
        self._title = title
        self._author = author
        self._ISBN = ISBN
        self._available = True

    def get_title(self):
        return self._title

    def get_author(self):
        return self._author

    def get_ISBN(self):
        return self._ISBN

    def is_available(self):
        return self._available

    def set_available(self, status):
        self._available = status

    def display_info(self):
        print(f"Title: {self._title}, Author: {self._author}, ISBN: {self._ISBN}, Available: {self._available}")


# --- Member class ---
class Member:
    def __init__(self, name, member_id):
        self._name = name
        self._member_id = member_id
        self._borrowed_books = []

    def get_name(self):
        return self._name

    def get_member_id(self):
        return self._member_id

    def get_borrowed_books(self):
        return self._borrowed_books

    def borrow_book(self, book):
        if book in self._borrowed_books:
            print(f"{self._name} already borrowed '{book.get_title()}'")
            return
        if book.is_available():
            self._borrowed_books.append(book)
            book.set_available(False)
            print(f"{self._name} borrowed '{book.get_title()}'")
        else:
            print(f"Sorry, '{book.get_title()}' is not available")

    def return_book(self, book):
        if book in self._borrowed_books:
            self._borrowed_books.remove(book)
            book.set_available(True)
            print(f"{self._name} returned '{book.get_title()}'")
        else:
            print(f"{self._name} did not borrow '{book.get_title()}'")


# --- Library class ---
class Library:
    def __init__(self):
        self.books = []
        self.members = []

    def add_book(self, book):
        self.books.append(book)
        print(f"Book '{book.get_title()}' added")
        book.display_info()

    def remove_book(self, book):
        if book in self.books:
            self.books.remove(book)
            print(f"Book '{book.get_title()}' removed")
        else:
            print("Book not found")

    def add_member(self, member):
        self.members.append(member)
        print(f"Member '{member.get_name()}' added")

    def find_member(self, member_id):
        for member in self.members:
            if member.get_member_id() == member_id:
                return member
        print("Member not found")
        return None

    def search_book(self, keyword):
        for book in self.books:
            if keyword.lower() in book.get_title().lower() or keyword.lower() in book.get_author().lower():
                print(f"Book found: {book.get_title()} by {book.get_author()}, Available: {book.is_available()}")
                return book
        print("Book not found")
        return None

    def lend_book(self, member, book):
        if book in self.books:
            member.borrow_book(book)
        else:
            print("Book not found in library")

    def accept_return(self, member, book):
        if book in self.books:
            member.return_book(book)
        else:
            print("Book not found in library")


# --- Main program ---
library = Library()

# Add sample members
library.add_member(Member("Loki", "M01"))
library.add_member(Member("Alice", "M02"))

while True:
    print("\n--- Library Menu ---")
    print("1. Add Book")
    print("2. Remove Book")
    print("3. Lend Book")
    print("4. Return Book")
    print("5. Search Book")
    print("6. Show All Books")
    print("7. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        title = input("Enter book title: ")
        author = input("Enter author name: ")
        ISBN = input("Enter ISBN: ")
        book = Book(title, author, ISBN)
        library.add_book(book)

    elif choice == "2":
        keyword = input("Enter book title or author to remove: ")
        book = library.search_book(keyword)
        if book:
            library.remove_book(book)

    elif choice == "3":
        keyword = input("Enter book title or author to lend: ")
        book = library.search_book(keyword)
        if book:
            member_id = input("Enter member ID: ")
            member = library.find_member(member_id)
            if member:
                library.lend_book(member, book)

    elif choice == "4":
        keyword = input("Enter book title or author to return: ")
        book = library.search_book(keyword)
        if book:
            member_id = input("Enter member ID: ")
            member = library.find_member(member_id)
            if member:
                library.accept_return(member, book)

    elif choice == "5":
        keyword = input("Enter book title or author to search: ")
        library.search_book(keyword)

    elif choice == "6":
        print("\nAll books in library:")
        for book in library.books:
            book.display_info()

    elif choice == "7":
        print("Exiting...")
        break

    else:
        print("Invalid choice. Try again.")
